function renderTraits() {
  if (!elAdvList || !elDisList) return;

  elAdvList.innerHTML = "";
  elDisList.innerHTML = "";

  advPool.forEach(name => {
    const label = document.createElement("label");
    label.className = "trait-item";
    label.dataset.name = name.toLowerCase();

    const input = document.createElement("input");
    input.type = "checkbox";
    input.value = name;
    input.checked = window.char.vorteile.includes(name);

    input.addEventListener("change", () => handleTraitChange("adv", name, input.checked));

    label.appendChild(input);
    label.appendChild(document.createTextNode(" " + name));
    elAdvList.appendChild(label);
  });

  disPool.forEach(name => {
    const label = document.createElement("label");
    label.className = "trait-item";
    label.dataset.name = name.toLowerCase();

    const input = document.createElement("input");
    input.type = "checkbox";
    input.value = name;
    input.checked = window.char.nachteile.includes(name);

    input.addEventListener("change", () => handleTraitChange("dis", name, input.checked));

    label.appendChild(input);
    label.appendChild(document.createTextNode(" " + name));
    elDisList.appendChild(label);
  });

  updateTraitState();
}

function handleTraitChange(type, name, checked) {
  if (type === "adv") {
    if (checked) {
      if (window.char.vorteile.length >= TRAIT_MAX_ADV) {
        showMsg("Es dürfen genau 2 Vorteile gewählt werden.");
        const cb = findTraitCheckbox("adv", name);
        if (cb) cb.checked = false;
        return;
      }
      window.char.vorteile.push(name);
    } else {
      window.char.vorteile = window.char.vorteile.filter(t => t !== name);
    }
  }

  if (type === "dis") {
    if (checked) {
      if (window.char.nachteile.length >= TRAIT_MAX_DIS) {
        showMsg("Es dürfen genau 3 Nachteile gewählt werden.");
        const cb = findTraitCheckbox("dis", name);
        if (cb) cb.checked = false;
        return;
      }
      window.char.nachteile.push(name);
    } else {
      window.char.nachteile = window.char.nachteile.filter(t => t !== name);
    }
  }

  updateTraitState();
  updateChronik();
  updateErweckenButton();
}

function findTraitCheckbox(type, name) {
  const container = type === "adv" ? elAdvList : elDisList;
  if (!container) return null;
  return [...container.querySelectorAll("input[type='checkbox']")]
    .find(cb => cb.value === name) || null;
}

function updateTraitState() {
  if (elCountAdv) elCountAdv.textContent = window.char.vorteile.length;
  if (elCountDis) elCountDis.textContent = window.char.nachteile.length;

  updateTraitDisabling("adv", window.char.vorteile.length >= TRAIT_MAX_ADV);
  updateTraitDisabling("dis", window.char.nachteile.length >= TRAIT_MAX_DIS);
}

function updateTraitDisabling(type, disableOthers) {
  const container = type === "adv" ? elAdvList : elDisList;
  const selected = type === "adv" ? window.char.vorteile : window.char.nachteile;
  if (!container) return;

  container.querySelectorAll(".trait-item").forEach(label => {
    const input = label.querySelector("input");
    const isSelected = selected.includes(input.value);

    if (disableOthers && !isSelected) {
      label.classList.add("disabled");
      input.disabled = true;
    } else {
      label.classList.remove("disabled");
      input.disabled = false;
    }
  });
}

function applyTraitSearch(type, term) {
  const container = type === "adv" ? elAdvList : elDisList;
  if (!container) return;
  const lower = term.trim().toLowerCase();

  container.querySelectorAll(".trait-item").forEach(label => {
    const name = label.dataset.name;
    label.style.display = (!lower || name.includes(lower)) ? "" : "none";
  });
}

