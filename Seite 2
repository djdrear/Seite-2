    showMsg("Bitte Vorname und Zuname eingeben.");
    return;
  }

  const loaded = await loadCharByName(vor, zu);
  if (!loaded) {
    showMsg("Charakter nicht gefunden.");
    return;
  }

  closeUebernehmenPopup();
  initIdentityFields();
  renderTraits();
  updateChronik();
  updateErweckenButton();
}

function initTraitSearchListeners() {
  if (elSearchAdv) {
    elSearchAdv.addEventListener("input", () => {
      applyTraitSearch("adv", elSearchAdv.value);
    });
  }

  if (elSearchDis) {
    elSearchDis.addEventListener("input", () => {
      applyTraitSearch("dis", elSearchDis.value);
    });
  }
}

async function initPage2() {
  initDomRefs();

  /* -----------------------------
     POPUP: Werte übernehmen
  ----------------------------- */
  if (elBtnWerteUebernehmen) {
    elBtnWerteUebernehmen.addEventListener("click", openUebernehmenPopup);
  }
  if (elBtnUebernehmenAbbrechen) {
    elBtnUebernehmenAbbrechen.addEventListener("click", closeUebernehmenPopup);
  }
  if (elBtnUebernehmenLaden) {
    elBtnUebernehmenLaden.addEventListener("click", handleUebernehmenLaden);
  }

  /* -----------------------------
     Traits zurücksetzen
  ----------------------------- */
  if (elBtnResetTraits) {
    elBtnResetTraits.addEventListener("click", () => {
      window.char.vorteile = [];
      window.char.nachteile = [];
      renderTraits();
      updateChronik();
      updateErweckenButton();
      showMsg("Traits zurückgesetzt.");
    });
  }

  /* -----------------------------
     Weiter zu Seite 3
  ----------------------------- */
if (elBtnNext) {
  elBtnNext.addEventListener("click", () => {
    window.location.href = "https://djdrear.github.io/Seite-3/";
  });
}

  /* -----------------------------
     Erwecken
  ----------------------------- */
  if (elBtnErwecken) {
    elBtnErwecken.addEventListener("click", () => {
      if (!isPage1Complete() || !isPage2Complete()) {
        showMsg("Charakter ist noch nicht vollständig.");
        return;
      }
      triggerOrbAwakening();
    });
  }

  /* -----------------------------
     Leave Modal
  ----------------------------- */
  if (elBtnLeaveCancel) {
    elBtnLeaveCancel.addEventListener("click", closeLeaveModal);
  }

if (elBtnLeaveConfirm) {
  elBtnLeaveConfirm.addEventListener("click", () => {
    window.location.href = "https://djdrear.github.io/Seite-3/";
  });
}

  /* -----------------------------
     WICHTIGER FIX:
     URL-Parameter nur übernehmen,
     wenn sie existieren!
  ----------------------------- */
  readNameFromURL();   // überschreibt NICHT mehr, wenn leer

  ensureCharStructure();

  /* -----------------------------
     WICHTIGER FIX:
     Charakter nur automatisch laden,
     wenn Name existiert.
     (Lokal sonst NICHT überschreiben!)
  ----------------------------- */
  if (window.char.name) {
    await loadCharFromCloudActive();
  }

  ensureCharStructure();

  /* -----------------------------
     Seite 2 initialisieren
  ----------------------------- */
  initIdentityFields();
  initCharacterPreview();
  renderTraits();
  updateChronik();
  drawChronikRadar();
  attachIdentityListeners();
  initTraitSearchListeners();
  updateErweckenButton();
}

/* -----------------------------
   EINZIGER Startpunkt
----------------------------- */
document.addEventListener("DOMContentLoaded", () => {
  initPage2();
});;
</script>
</body>
</html>
