  elTransientMsg = document.getElementById("transient-msg");
  elHeaderSubData = document.getElementById("header-sub-data");
}

async function loadCharFromCloudActive() {
  if (!window.char) window.char = {};

  const name  = window.char.name  || "";
  const title = window.char.title || "";

  if (elHeaderSubData) {
    elHeaderSubData.textContent = "Charakterdaten werden geladen...";
  }

  if (!name) {
    console.warn("⚠️ Aktiver Charakter hat keinen Namen.");
    if (elHeaderSubData) {
      elHeaderSubData.textContent = "Kein aktiver Charakter – bitte auf Seite 1 anlegen.";
    }
    return null;
  }

  const data = await undra.load(name, title);
  if (!data) {
    if (elHeaderSubData) {
      elHeaderSubData.textContent = "Fehler beim Laden der Charakterdaten.";
    }
    return null;
  }

  Object.assign(window.char, data);
  ensureCharStructure();

  if (data.meta) {
    window.char.name  = data.meta.name  || window.char.name;
    window.char.title = data.meta.title || window.char.title;
  }

  initIdentityFields();
  renderTraits();
  updateChronik();
  drawChronikRadar();
  initCharacterPreview();
  updateErweckenButton();

  if (elHeaderSubData) {
    elHeaderSubData.textContent = "Charakter erfolgreich geladen.";
  }

  console.log("Aktiver Charakter geladen:", window.char);
  return data;
}

