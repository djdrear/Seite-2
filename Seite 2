function generateCharacterPitch() {
  const c = window.char;
  const I = c.identity;

  const name = c.name || "Dieser Charakter";
  const title = c.title ? `, ${c.title}` : "";
  const race = c.race || "Unbekanntes Volk";
  const sub = c.sub ? ` (${c.sub})` : "";
  const prof = c.prof || "Wanderer";

  const gabe = c.raceAbility || null;
  const subAbility = c.subAbility || c.sub || null;
  const bonus = c.attrBonusNote || null;

  const vorteile = c.vorteile.length ? c.vorteile.join(", ") : null;
  const nachteile = c.nachteile.length ? c.nachteile.join(", ") : null;

  const merkmale = [
    I.eyes && `${I.eyes} strahlende Augen`,
    I.hair && `glänzendes Haar in ${I.hair}`,
    I.voice && `seine Stimme, ${I.voice} und einzigartig`,
    I.specialmarks && `gekennzeichnet durch ${I.specialmarks}`,
    I.clothes && `sein Kleidungsstil besteht hauptsächlich aus ${I.clothes} und ist sehr prägnant.`
  ].filter(Boolean);

  let pitch = `${name}${title} ist ein${race.match(/^[aeiou]/i) ? "n" : ""} ${race}${sub}, `
             + `der als ${prof} seinen Weg durch UNDRA sucht. `;

  if (gabe) pitch += `Seine Gabe „${gabe}“ verleiht ihm eine besondere Aura. `;
  if (subAbility) pitch += `Die Fähigkeit „${subAbility}“ deutet auf ein verborgenes Potenzial hin. `;
  if (bonus) pitch += `Ein natürlicher Bonus auf ${bonus} stärkt seine innere Essenz. `;

  if (merkmale.length) {
    pitch += `Seine Erscheinung wird geprägt durch ${merkmale.join(", ")}. `;
  }

  if (vorteile) pitch += `Zu seinen Stärken zählen ${vorteile}. `;
  if (nachteile) pitch += `Doch auch ${nachteile} formen seinen Weg. `;

  pitch += `Etwas in seinem Schicksal scheint darauf zu warten, endlich erwacht zu werden.`;

  return pitch;
}
