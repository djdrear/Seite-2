<script>
window.char = window.char || {};
window.undra = window.undra || {};

console.log(window.char);
// URL → Name & Titel übernehmen
function readNameFromURL() {
  const params = new URLSearchParams(window.location.search);
  const name  = params.get("name");
  const title = params.get("title");

  // Nur überschreiben, wenn Parameter existieren
  if (name)  window.char.name  = name;
  if (title) window.char.title = title;
}
  

function makeCharId(name, title) {
  return `undra_${(name || "namenlos").trim().toLowerCase()}_${(title || "ohne").trim().toLowerCase()}`
    .replace(/\s+/g, "_");
}

// CLOUD SPEICHERN
undra.save = async function (name, title, char) {
  const id = makeCharId(name, title);
  try {
    const res = await fetch(`https://undra.djdrear.workers.dev/save/${id}`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(char)
    });
    if (!res.ok) {
      console.error("Cloud‑Speichern fehlgeschlagen:", await res.text());
      return false;
    }
    return true;
  } catch (err) {
    console.error("Cloud‑Save Fehler:", err);
    return false;
  }
};

// CLOUD LADEN
undra.load = async function (name, title = "") {
  const id = makeCharId(name, title);
  try {
    const res = await fetch(`https://undra.djdrear.workers.dev/load/${id}`);
    if (!res.ok) {
      console.error("Cloud‑Laden fehlgeschlagen:", await res.text());
      return null;
    }
    return await res.json();
  } catch (err) {
    console.error("Cloud‑Load Fehler:", err);
    return null;
  }
};

// Attribute
const ATTRIBUTES = [
  "Mut","Intelligenz","Fingerfertigkeit","Gewandtheit","Körperkraft",
  "Körperbewusstsein","Konstitution","Charisma","Sozialstatus",
  "Geistiger Zustand","Intuition","Angriff","Verteidigung","Abwehrschlag",
  "Fernkampf","Trefferchance","Technik"
];

const ATTR_SHORT = [
  "MU","IN","FF","GE","KK",
  "KB","KO","CH","SS",
  "GZ","IT","AN","VE","AS",
  "FK","TC","TE"
];

const TRAIT_MAX_ADV = 2;
const TRAIT_MAX_DIS = 3;

// DOM-Referenzen
let elAge, elHeight, elWeight, elEyes, elHair, elVoice, elClothes, elSpecialMarks;
let elStory;
let elPreviewImg, elPlaceholder, elPreviewNameLine, elPreviewRace, elPreviewProf, elPreviewSpec, elPreviewShortdesc;
let elAbilityRace, elAbilitySub, elAbilityAttr;
let elAdvList, elDisList, elSearchAdv, elSearchDis, elBtnResetTraits, elCountAdv, elCountDis;
let elChronikTextBlock, elChronikRadar, elChronikRadarCtx;
let elBtnNext, elBtnErwecken, elBtnToPage3;
let elLeaveModal, elLeaveSummary, elBtnLeaveCancel, elBtnLeaveConfirm;
let elOrbFlatline, elOrbContainer, elOrbArea;
let elMaybePitch;
let elBtnWerteUebernehmen;
let elPopupUebernehmen, elUebernehmenVorname, elUebernehmenZuname, elBtnUebernehmenAbbrechen, elBtnUebernehmenLaden;
let elTransientMsg;
let elHeaderSubData;

let transientTimeout = null;

function showMsg(text, ms = 2200) {
  if (!elTransientMsg) return;
  elTransientMsg.textContent = text;
  elTransientMsg.style.opacity = "1";
  if (transientTimeout) clearTimeout(transientTimeout);
  transientTimeout = setTimeout(() => {
    elTransientMsg.style.opacity = "0";
  }, ms);
}

function ensureCharStructure() {
  if (!window.char || typeof window.char !== "object") window.char = {};
  const c = window.char;

  if (typeof c.name !== "string")  c.name  = "";
  if (typeof c.title !== "string") c.title = "";

  if (!c.identity) {
    c.identity = {
      age: "",
      height: "",
      weight: "",
      eyes: "",
      hair: "",
      voice: "",
      clothes: "",
      specialmarks: "",
      shortdesc: "",
      story: ""
    };
  }

  if (!Array.isArray(c.vorteile))  c.vorteile  = [];
  if (!Array.isArray(c.nachteile)) c.nachteile = [];

  if (!c.attrs || typeof c.attrs !== "object") c.attrs = {};
  ATTRIBUTES.forEach((full) => {
    if (c.attrs[full] == null) c.attrs[full] = 0;
  });
}

