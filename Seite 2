/* ============================================================
   ⭐ NEUER ORB‑CSS‑BLOCK (Drop‑In Replacement)
   ============================================================ */

#orb-ritual-area {
  width: 100%;
  height: 360px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  margin-top: 40px;
  margin-bottom: 80px;
  background: radial-gradient(circle at center,
    rgba(10,0,20,0.9),
    rgba(5,0,10,0.95),
    #050308 80%);
  overflow: visible;
}

.flatline {
  width: 360px;
  height: 6px;
  border-radius: 4px;
  background: #ff0000;
  box-shadow: 0 0 25px rgba(255,0,0,0.9);
  animation: ekg-flat 1.2s ease-out infinite;
}

@keyframes ekg-flat {
  0% { opacity: 1; }
  50% { opacity: 0.4; }
  100% { opacity: 1; }
}

.orb-hidden { display: none; }

.orbit-wrapper {
  position: relative;
  width: 180px;
  height: 180px;
  display: grid;
  place-items: center;
  filter: drop-shadow(0 0 25px rgba(180,0,255,0.8));
}

.orbit-core {
  width: 160px;
  height: 160px;
  border-radius: 50%;
  background:
    radial-gradient(circle at 40% 30%, #ff4a4a, #6b0000 40%, #1a0000 70%),
    radial-gradient(circle at center, rgba(255,80,0,0.4), transparent 70%);
  box-shadow:
    0 0 40px rgba(255,0,0,0.9),
    inset 0 0 35px rgba(255,200,200,0.4),
    inset 0 0 60px rgba(255,80,80,0.3);
  animation:
    heartbeat 1.4s ease-in-out infinite,
    vortex-spin 6s linear infinite;
}

@keyframes heartbeat {
  0%   { transform: scale(1); }
  25%  { transform: scale(1.22); }
  40%  { transform: scale(0.92); }
  60%  { transform: scale(1.18); }
  100% { transform: scale(1); }
}

@keyframes vortex-spin {
  0%   { filter: hue-rotate(0deg); }
  100% { filter: hue-rotate(360deg); }
}

.orbit-wrapper::before {
  content: "";
  position: absolute;
  width: 220px;
  height: 220px;
  border-radius: 50%;
  border: 2px solid rgba(180,108,255,0.4);
  box-shadow:
    0 0 18px rgba(180,108,255,0.6),
    inset 0 0 12px rgba(120,0,200,0.4);
  animation: runes-rotate 9s linear infinite;
}

@keyframes runes-rotate {
  0%   { transform: rotate(0deg); opacity: 0.8; }
  50%  { opacity: 1; }
  100% { transform: rotate(360deg); opacity: 0.8; }
}

.orbit-wrapper::after {
  content: "";
  position: absolute;
  width: 260px;
  height: 260px;
  border-radius: 50%;
  background:
    radial-gradient(circle,
      rgba(255,200,80,0.15) 0%,
      rgba(255,80,0,0.05) 40%,
      transparent 70%);
  animation: particle-flicker 2.4s ease-in-out infinite;
  pointer-events: none;
}

@keyframes particle-flicker {
  0%   { opacity: 0.25; transform: scale(1); }
  50%  { opacity: 0.45; transform: scale(1.08); }
  100% { opacity: 0.25; transform: scale(1); }
}

.flash-explosion {
  position: absolute;
  width: 0;
  height: 0;
  border-radius: 50%;
  background:
    radial-gradient(circle,
      rgba(255,255,255,1),
      rgba(200,120,255,0.8),
      rgba(120,0,200,0.4),
      transparent 70%);
  box-shadow:
    0 0 60px rgba(255,255,255,1),
    0 0 120px rgba(180,0,255,0.8);
  animation: flashEpic 1.2s ease-out forwards;
  pointer-events: none;
}

@keyframes flashEpic {
  0%   { width: 40px; height: 40px; opacity: 1; transform: scale(0.2); }
  40%  { width: 420px; height: 420px; opacity: 1; transform: scale(1.4); }
  70%  { width: 520px; height: 520px; opacity: 0.6; transform: scale(1.8); }
  100% { width: 620px; height: 620px; opacity: 0; transform: scale(2.4); }
}

/* Epischer UNDRA-Erwecken-Button */
.btn-erwecken {
  margin-top: 15px;                 /* Button tiefer setzen */
  padding: 14px 26px;               /* größerer Button */
  font-size: 15px;                  /* größere Schrift */
  border-radius: 10px;
  border: 2px solid rgba(212,175,55,0.6);
  background: rgba(40,20,0,0.6);
  color: var(--gold-bright);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  transition: all 0.25s ease;
  opacity: 0.4;
  pointer-events: none;
}

/* Aktivierter Zustand – goldener Puls + Glow */
.btn-erwecken.active {
  background: linear-gradient(135deg, #8a6b1f, #d4af37);
  border-color: #f8e7b0;
  color: #1a0b00;
  cursor: pointer;
  opacity: 1;
  pointer-events: auto;

  box-shadow:
    0 0 12px rgba(248,231,176,0.8),
    0 0 22px rgba(212,175,55,0.9),
    inset 0 0 12px rgba(255,255,255,0.4);

  animation: erweckenPulse 1.6s ease-in-out infinite;
}

/* Goldener Puls */
@keyframes erweckenPulse {
  0% {
    box-shadow:
      0 0 10px rgba(248,231,176,0.6),
      0 0 18px rgba(212,175,55,0.7),
      inset 0 0 8px rgba(255,255,255,0.3);
    transform: scale(1);
  }
  50% {
    box-shadow:
      0 0 18px rgba(248,231,176,1),
      0 0 28px rgba(212,175,55,1),
      inset 0 0 14px rgba(255,255,255,0.5);
    transform: scale(1.05);
  }
  100% {
    box-shadow:
      0 0 10px rgba(248,231,176,0.6),
      0 0 18px rgba(212,175,55,0.7),
      inset 0 0 8px rgba(255,255,255,0.3);
    transform: scale(1);
  }
}

@keyframes awakenPulse {
  0%   { box-shadow: 0 0 10px rgba(120,160,255,0.6); }
  50%  { box-shadow: 0 0 22px rgba(180,200,255,1); }
  100% { box-shadow: 0 0 10px rgba(120,160,255,0.6); }
}


