function drawChronikRadar() {
  if (!elChronikRadar || !elChronikRadarCtx) return;

  const canvas = elChronikRadar;
  const ctx = elChronikRadarCtx;

  const w = canvas.width = 180;
  const h = canvas.height = 180;
  const cx = w / 2;
  const cy = h / 2;
  const radius = 75;

  ctx.clearRect(0, 0, w, h);

  const attrs = window.char.attrs || {};

  ctx.beginPath();
  ctx.arc(cx, cy, radius + 20, 0, Math.PI * 2);
  ctx.fillStyle = "rgba(180,108,255,0.08)";
  ctx.fill();

  const count = ATTRIBUTES.length;
  const step = (Math.PI * 2) / count;

  ctx.strokeStyle = "rgba(212,175,55,0.18)";
  ctx.lineWidth = 1;

  for (let i = 0; i < count; i++) {
    const angle = step * i - Math.PI / 2;
    const x = cx + Math.cos(angle) * radius;
    const y = cy + Math.sin(angle) * radius;

    ctx.beginPath();
    ctx.moveTo(cx, cy);
    ctx.lineTo(x, y);
    ctx.stroke();

    const tx = cx + Math.cos(angle) * (radius + 6);
    const ty = cy + Math.sin(angle) * (radius + 6);

    ctx.fillStyle = "#f8e7b0";
    ctx.font = "8px serif";
    ctx.textAlign = "center";
    ctx.textBaseline = "middle";
    ctx.fillText(ATTR_SHORT[i], tx, ty);
  }

  ctx.beginPath();
  ctx.arc(cx, cy, radius, 0, Math.PI * 2);
  ctx.strokeStyle = "rgba(248,231,176,0.6)";
  ctx.stroke();

  ctx.beginPath();
  for (let i = 0; i < count; i++) {
    const val = attrs[ATTRIBUTES[i]] || 0;
    const factor = Math.max(0, Math.min(1, val / 10));
    const r = radius * (0.1 + factor * 0.9);

    const angle = step * i - Math.PI / 2;
    const x = cx + Math.cos(angle) * r;
    const y = cy + Math.sin(angle) * r;

    if (i === 0) ctx.moveTo(x, y);
    else ctx.lineTo(x, y);
  }
  ctx.closePath();

  ctx.fillStyle = "rgba(208,70,70,0.35)";
  ctx.strokeStyle = "#d4af37";
  ctx.lineWidth = 2;
  ctx.fill();
  ctx.stroke();
}

